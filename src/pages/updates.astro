---
import '../styles/founder-preview.css';
import '../styles/preview-updates.css';
import { releases, comingSoon } from '../data/preview-updates';
import SearchMetadata from '../components/SearchMetadata.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AppStoreBadge from '../components/AppStoreBadge.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f2" />
    <SearchMetadata title="What’s new — Vylo" description="What’s shipped in Vylo and what’s coming next." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260309" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png?v=20260309" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png?v=20260309" />
    <link rel="shortcut icon" href="/icons/favicon.ico?v=20260309" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/apple-touch-icon-152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/icons/apple-touch-icon-120.png" />
  </head>
  <body class="founder-preview">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPage="updates" />
    <main id="main" class="preview-updates">
      <header class="updates-intro page-width">
        <h1>What’s new<br /><em>in Vylo.</em></h1>
        <div><p>Recent releases and what’s next.</p><nav class="updates-sections" aria-label="Product updates"><a href="#shipped">Shipped</a><a href="#coming-soon">Coming soon</a></nav></div>
      </header>
      <section class="shipped-section page-width" id="shipped" aria-labelledby="shipped-title">
        <h2 id="shipped-title">Shipped</h2>
        <div class="shipped-months">
          {releases.map((release, index) => <section class:list={['shipped-month', {'latest-release': index === 0}]} aria-labelledby={`month-${index}`}>
            <h3 id={`month-${index}`}><span>{release.month.split(' ')[0]}</span><span>{release.month.split(' ')[1]}</span></h3>
            <div class="shipped-items">{release.items.map(item => <article><h4>{item.title}</h4><p>{item.description}</p>{item.article && <p><a class="release-article" href={`/help/articles/${item.article}/`}>How Projected Spend works <span aria-hidden="true">↗</span></a></p>}{item.appStore && <div class="release-download"><AppStoreBadge /></div>}</article>)}</div>
          </section>)}
        </div>
      </section>
      <section class="coming-section" id="coming-soon" aria-labelledby="coming-title">
        <div class="page-width"><div class="coming-heading"><div><h2 id="coming-title">Coming soon</h2></div><a class="text-link" href="mailto:hi@myvylo.com?subject=Vylo%20product%20feedback">Share an idea</a></div>
        <div class="coming-items">{comingSoon.map(item => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div>
      </section>
      <div class="updates-return page-width"><a class="text-link" href="/#inside-vylo">Explore Vylo</a></div>
    </main>
    <footer class="site-end page-width">
      <div class="footer-top"><div><a href="/" class="footer-brand">vylo.</a><p>Household accounts, spending,<br />budgets, and net worth.</p></div><div class="footer-directory"><nav aria-label="Explore Vylo"><span>VYLO</span><a href="/#the-story">The founder’s letter</a><a href="/#inside-vylo">Features</a><a href="/#pricing">Pricing</a><a href="/compare/">Compare</a><a href="/updates/">What’s new</a></nav><nav aria-label="Support and policies"><span>HELP & POLICIES</span><a href="mailto:hi@myvylo.com">Contact</a><a href="/#security">Security</a><a href="https://app.myvylo.com/privacy-policy">Privacy policy</a><a href="https://app.myvylo.com/terms-of-use">Terms of use</a></nav></div></div>
      <div class="footer-bottom"><span>© 2026 Vylo</span></div>
    </footer>
  </body>
</html>
