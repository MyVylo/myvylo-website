════════════════════════════════════════════════════════════════ -->
<section class="py-16 px-4 sm:px-6">
  <div class="reveal max-w-3xl mx-auto text-center glass rounded-2xl card-glow px-8 py-14"
       style="background: linear-gradient(135deg, rgba(99,102,241,.14), rgba(32,43,65,.85));">
    <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Less noise. More clarity.</h2>
    <p class="text-white/75 text-lg mb-8 max-w-md mx-auto">Takes two minutes to connect. From there, it runs itself.</p>
    <a href="https://app.myvylo.com/signup"
       class="button-shimmer inline-flex items-center gap-2 px-7 py-3.5
              text-white font-semibold rounded-xl text-sm transition-all duration-200
              hover:shadow-xl hover:shadow-indigo-500/30 hover:-translate-y-0.5"
       style="background: linear-gradient(135deg, #6366f1, #7c3aed);">
      Get started — it's free
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<script>
  // Hero indicator dots
  const dots = document.querySelectorAll('.dot');
  function updateDots() {
    const phase = Math.floor((Date.now() / 1000) % 9 / 3);
    dots.forEach((d, i) => {
      d.classList.toggle('bg-indigo-400', i === phase);
      d.classList.toggle('bg-white/20',   i !== phase);
    });
  }
  setInterval(updateDots, 120);
  updateDots();

  // Scroll-reveal
  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObserver.unobserve(e.target); }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // Bar / height animations
  const barObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (!e.isIntersecting) return;
      // Horizontal bars (width)
      e.target.querySelectorAll('[data-w]').forEach((bar) => {
        const el = bar as HTMLElement;
        el.style.width = el.dataset.w!;
      });
      // Vertical bars (height)
      e.target.querySelectorAll('[data-h]').forEach((bar) => {
        const el = bar as HTMLElement;
        el.style.height = el.dataset.h!;
      });
      barObserver.unobserve(e.target);
    }),
    { threshold: 0.25 }
  );
  document.querySelectorAll('.bar-section').forEach(el => barObserver.observe(el));

  // ── Before/After Slider ─────────────────────────────────────────
  {
    const slider   = document.getElementById('vylo-slider')   as HTMLElement | null;
    const afterEl  = document.getElementById('slider-after')  as HTMLElement | null;
    const handleEl = document.getElementById('slider-handle') as HTMLElement | null;

    if (slider && afterEl && handleEl) {
      let dragging   = false;
      let currentPct = 60;

      function applyPos(pct: number) {
        currentPct = Math.max(5, Math.min(95, pct));
        const p = currentPct + '%';
        afterEl.style.clipPath = `inset(0 0 0 ${p})`;
        handleEl.style.left    = p;
      }

      function pctFromX(clientX: number) {
        const r = slider.getBoundingClientRect();
        return ((clientX - r.left) / r.width) * 100;
      }

      // Mouse
      slider.addEventListener('mousedown', (e) => { dragging = true; applyPos(pctFromX((e as MouseEvent).clientX)); });
      document.addEventListener('mousemove', (e) => { if (dragging) applyPos(pctFromX((e as MouseEvent).clientX)); });
      document.addEventListener('mouseup',   () => { dragging = false; });

      // Touch (on the slider itself to avoid interfering with page scroll elsewhere)
      slider.addEventListener('touchstart', (e) => {
        dragging = true;
        applyPos(pctFromX((e as TouchEvent).touches[0].clientX));
        e.preventDefault();
      }, { passive: false });
      slider.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        applyPos(pctFromX((e as TouchEvent).touches[0].clientX));
        e.preventDefault();
      }, { passive: false });
      document.addEventListener('touchend', () => { dragging = false; });

      // Keyboard
      slider.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft')  { applyPos(currentPct - 5); e.preventDefault(); }
        if (e.key === 'ArrowRight') { applyPos(currentPct + 5); e.preventDefault(); }
      });

      // Scroll-triggered hint animation (reveals Vylo side, then returns)
      function easeInOut(t: number) { return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hintObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting || slider.dataset.hinted) return;
          slider.dataset.hinted = '1';

          if (!prefersReducedMotion) {
            let startTime: number | null = null;
            const fromPct = 60, toPct = 30, duration = 1600;

            function hintFrame(ts: number) {
              if (startTime === null) startTime = ts;
              const t = Math.min((ts - startTime) / duration, 1);
              // Ease out to Vylo side, ease back to start
              const pos = t < 0.5
                ? fromPct + (toPct - fromPct) * easeInOut(t * 2)
                : toPct   + (fromPct - toPct) * easeInOut((t - 0.5) * 2);
              applyPos(pos);
              if (t < 1) requestAnimationFrame(hintFrame);
            }

            setTimeout(() => requestAnimationFrame(hintFrame), 800);
          }

          hintObserver.unobserve(slider);
        });
      }, { threshold: 0.55 });
      hintObserver.observe(slider);
    }
  }

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon   = btn.querySelector('.faq-icon')!;
      const isOpen = answer.classList.toggle('open');
      icon.classList.toggle('open', isOpen);
      btn.closest('#faq-list')!.querySelectorAll('.faq-answer').forEach(a => {
        if (a !== answer) {
          a.classList.remove('open');
          (a.previousElementSibling as HTMLElement).querySelector('.faq-icon')!.classList.remove('open');
        }
      });
    });
  });
</script>

</Layout>
