---
import '../styles/founder-preview.css';
import FeatureWalkthrough from '../components/FeatureWalkthrough.astro';
import { featureWalkthroughs as views } from '../data/feature-walkthroughs';
import ClutterComparison from '../components/ClutterComparison.astro';
const signup = 'https://app.myvylo.com/signup';
const questions = [
  { q: 'What am I actually getting?', a: 'Connected accounts, transactions, budgets, income, and net worth for your household. Vylo categorizes transactions automatically; you can change categories or add cash purchases anytime.' },
  { q: 'How long does setup take?', a: 'When you first connect your accounts, Vylo imports and categorizes the past 90 days of transactions. This takes about five minutes. After that, new transactions sort themselves—even while you sleep.' },
  { q: 'Can I use Vylo with my partner?', a: 'Yes. Invite them by email. They get their own login and connect their accounts to your shared household. There’s no extra charge for household members.' },
  { q: 'Can Vylo move my money?', a: 'No. Connections are read-only: Vylo can see balances and transactions, but cannot make payments or transfers. It does not store your banking password.' },
  { q: 'What if a transaction lands in the wrong category?', a: 'Change the category, and the budget updates too. You can also create, rename, or merge categories and update several transactions at once.' },
  { q: 'What does it cost after the first month?', a: 'After your $2 first month, it’s $7/month for the whole household. All features are included. No annual commitment; cancel anytime.' },
  { q: 'Where can I ask a question before signing up?', a: 'Email hi@myvylo.com with any questions.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f2" />
    <meta name="description" content="Track household accounts, spending, budgets, and net worth with Vylo. $2 for your first month, then $7/month for the whole household. Cancel anytime." />
    <link rel="canonical" href="https://www.myvylo.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260309" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png?v=20260309" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png?v=20260309" />
    <link rel="shortcut icon" href="/icons/favicon.ico?v=20260309" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/icons/apple-touch-icon-152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/icons/apple-touch-icon-120.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.myvylo.com/" />
    <meta property="og:title" content="Vylo — Know where your money goes." />
    <meta property="og:description" content="Track household accounts, spending, budgets, and net worth with Vylo. $2 for your first month, then $7/month for the whole household. Cancel anytime." />
    <meta property="og:image" content="https://www.myvylo.com/icons/icon-512.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Vylo — Know where your money goes." />
    <meta name="twitter:description" content="Track household accounts, spending, budgets, and net worth with Vylo. $2 for your first month, then $7/month for the whole household. Cancel anytime." />
    <meta name="twitter:image" content="https://www.myvylo.com/icons/icon-512.png" />
    <title>Vylo — Know where your money goes.</title>
  </head>
  <body class="founder-preview">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead page-width">
      <a href="/" class="wordmark" aria-label="Vylo home"><img src="/vylo-light-logo.svg" alt="Vylo" width="282" height="129" /></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#the-story">Why Vylo</a>
        <a href="#inside-vylo">Features</a>
        <a href="#security">Security</a>
        <a href="#pricing">Pricing</a>
        <a href="/updates/">Updates</a>
      </nav>
      <div class="nav-actions"><a class="signin" href="https://app.myvylo.com/signin">Sign in</a><a class="button button-small" href={signup}>Try Vylo</a></div>
    </header>

    <main id="main">
      <section class="opening page-width" aria-labelledby="opening-title">
        <h1 id="opening-title">Know where your money goes.<br /><em>Without the extra work.</em></h1>
        <p class="opening-copy">Track your household’s accounts, spending, budgets, and net worth together. Vylo sorts the transactions and keeps everyone up to date.</p>
        <div class="opening-actions"><a class="button" href={signup}>Try Vylo for $2</a><a class="text-link" href="#the-story">Why another money app?</a></div>
        <p class="price-note">$2 for your first month, then $7/month after that. No annual commitments. Cancel anytime.</p>
      </section>

      <section class="first-look page-width" aria-label="Vylo dashboard">
        <div class="product-stage">
          <div class="hero-product-image"><img src="/product/dashboard-demo-september-2026.jpg" alt="The current Vylo dashboard showing a demo household’s income, spending, savings, budget health, and recent transactions." width="1200" height="897" fetchpriority="high" /></div>
          <a href="#inside-vylo" class="screen-invitation">Have a look around</a>
        </div>

        <div class="small-promises"><span>Connected accounts</span><span>Automatic categorization</span><span>Monthly budgets</span><span>Household sharing</span></div>
      </section>

      <section class="founder-letter page-width" id="the-story" aria-labelledby="letter-title">
        <article class="letter-body">
          <h2 id="letter-title">Where did all<br /><em>my money go?</em></h2>
          <p>Hey, I’m Faraz.</p>
          <p class="letter-introduction">I know there are plenty of money apps out there. I built Vylo because I kept ending up back in Excel.</p>
          <h3 class="letter-subheading"><span>A little background.</span></h3>
          <p>No matter how much I earned, I’d reach the end of the month wondering where it had gone. I knew the big expenses. It was everything in between that got away from me. Without a clear picture, I wasn’t sure what to change.</p>
          <p>Then I got married and had a kid. I wanted to feel confident we were looking after our family, and “I think we’re doing okay” was starting to feel like a fairly loose financial plan.</p>
          <p>So I started trying money apps. Some were complicated. Others were expensive and full of features I didn’t need. Getting a handle on our money was becoming another thing to get a handle on.</p>
          <h3 class="letter-subheading"><span>Back to Excel.</span></h3>
          <p>I copied expenses over, categorized them how I wanted, and built the views that helped me see what was happening. That was the appeal: I could make it work for our household. Our categories. Our rules. Everything where it made sense to us.</p>
          <p>It worked. But somewhere along the way, I’d given myself an <strong class="letter-underline">unpaid Sunday job.</strong> I wanted the clarity and flexibility without all the upkeep. It seemed reasonable to think something like that should exist.</p>
          <h3 class="letter-subheading"><span>That’s why I built Vylo.</span></h3>
          <p>It brings your accounts and transactions together and handles most of the sorting. You choose your categories, set your rules, and build a budget around how your household actually lives. You can follow your spending and net worth over time, and keep everyone on the same page.</p>
          <p>There’s no annual commitment, either. You should have time to see whether it fits.</p>
          <p>And once you’re set up, the idea is to need it a little less. Let Vylo handle the routine work in the background, flag what needs your attention, and give you a clear picture when you sit down at the end of the month.</p>
          <p class="letter-resolution">Money can be hard enough to figure out. Keeping track of it should make life easier. I hope Vylo does that for you, and gives you a little more of your Sunday back.</p>
          <p>If something isn’t working for you, or you have an idea, email me at <a href="mailto:hi@myvylo.com">hi@myvylo.com</a>. I read and reply to every email myself.</p>
          <p>Thanks for giving Vylo a try.</p>
          <div class="founder-signoff"><p class="founder-identity"><strong>Faraz</strong></p></div>
        </article>
      </section>

      <section class="product-chapter" id="inside-vylo" aria-labelledby="product-title">
        <div class="page-width">
          <div class="chapter-heading"><h2 id="product-title">Four questions.<br /><em>One place to answer them.</em></h2></div>
          <div class="product-explorer">
            <div class="product-tabs" role="tablist" aria-label="Explore Vylo features" aria-orientation="vertical">
              {views.map((view, index) => <button type="button" id={`tab-${view.id}`} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`panel-${view.id}`} tabindex={index === 0 ? 0 : -1}><span class="tab-number">0{index + 1}</span><span><strong>{view.question}</strong><span class="tab-description">{view.name}</span></span></button>)}
            </div>
            <div class="product-panels">
              {views.map((view, index) => <section id={`panel-${view.id}`} role="tabpanel" aria-labelledby={`tab-${view.id}`} tabindex="0" hidden={index !== 0}>
                <FeatureWalkthrough view={view} />
              </section>)}
            </div>
          </div>

        </div>
      </section>

      <section class="manifesto page-width" id="before-and-after" aria-labelledby="manifesto-title">

        <h2 id="manifesto-title">Track your money.<br /><span>Skip the busywork.</span></h2>
        <ClutterComparison />
      </section>

      <section class="security-chapter" id="security" aria-labelledby="trust-title">
        <div class="page-width">
          <div class="security-heading"><div><h2 id="trust-title">Vylo can see your balances.<br /><em>It can’t move your money.</em></h2></div><p>Vylo connects through <strong>Plaid</strong> and <strong>Finicity, a Mastercard company.</strong> Plaid is the same bank-connection provider used by <a href="https://plaid.com/en-gb/what-is-plaid/" target="_blank" rel="noopener">Venmo</a>, <a href="https://help.wealthsimple.com/hc/en-ca/articles/360056580394-Link-a-bank-account" target="_blank" rel="noopener">Wealthsimple</a>, and <a href="https://robinhood.com/us/en/support/articles/robinhood-banking-money-movements/" target="_blank" rel="noopener">Robinhood</a>. Vylo never stores your banking password.</p></div>
          <div class="connection-flow" aria-label="Your bank sends account data through Plaid or Finicity to Vylo after you authorize the connection.">
            <div class="flow-bank"><strong>Your bank</strong><p>You choose the accounts to connect.</p></div>
            <span class="flow-connector" aria-hidden="true"></span>
            <div class="flow-provider"><strong>Plaid <span class="provider-or">or</span> Finicity</strong><p>The provider handles the connection.</p></div>
            <span class="flow-connector" aria-hidden="true"></span>
            <div class="flow-vylo"><strong>Vylo<span class="read-only-tag">Read-only</span></strong><p>Account balances and transactions, organized.</p></div>
          </div>
          <div class="security-details"><article><span class="security-symbol" aria-hidden="true">≡</span><h3>No payments or transfers.</h3><p>Vylo can read connected account data. It cannot transfer money, make payments, or change your bank accounts.</p></article><article><span class="security-symbol" aria-hidden="true">•••</span><h3>No bank password stored.</h3><p>Authentication happens through your bank or connection provider. Vylo does not see or store your banking username or password.</p></article><article><span class="security-symbol" aria-hidden="true">✓</span><h3>Disconnect when you need to.</h3><p>Choose which accounts to share. Disconnect them in Vylo or manage access through the provider.</p></article></div>
          <div class="security-links"><p>Read the details:</p><a href="https://app.myvylo.com/privacy-policy">Vylo privacy policy</a><a href="https://plaid.com/trust-safety/" target="_blank" rel="noopener">Plaid security</a><a href="https://www.finicity.com/terms-privacy/en-US/" target="_blank" rel="noopener">Finicity privacy & data access</a></div>
        </div>
      </section>

      <section class="pricing-chapter" id="pricing" aria-labelledby="pricing-title">
        <div class="page-width pricing-inner">
          <div class="pricing-story"><h2 id="pricing-title">One household.<br />One plan.<br /><em>All of Vylo.</em></h2><p>All features and unlimited household members are included.</p></div>
          <div class="plan-card"><p class="plan-label">THE HOUSEHOLD PLAN</p><div class="plan-price"><span class="currency">$</span><strong>2</strong><span>for your<br />first month</span></div><p class="plan-renewal">Then <strong>$7/month</strong> for your whole household.</p><ul><li>All your connected accounts</li><li>Transactions & automatic categorization</li><li>Budgets, income & net-worth tracking</li><li>Unlimited household members</li></ul><a href={signup} class="button plan-button">Try Vylo for $2</a><p class="plan-fineprint">No annual commitment. Cancel anytime.</p></div>
        </div>
      </section>

      <section class="questions-chapter page-width" id="faq" aria-labelledby="faq-title">
        <div class="questions-heading"><h2 id="faq-title">Before you<br />connect an account.</h2><p>For anything else:<br /><a href="mailto:hi@myvylo.com">hi@myvylo.com</a></p></div>
        <div class="question-list">{questions.map(({ q, a }) => <details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div>
      </section>

      <section class="closing-chapter page-width" aria-labelledby="closing-title"><h2 id="closing-title">Ready to give<br /><em>Vylo a try?</em></h2><a href={signup} class="button">Try Vylo for $2</a><p class="price-note">$2 for your first month, then $7/month after that. No annual commitments. Cancel anytime.</p></section>
    </main>
    <footer class="site-end page-width">
      <div class="footer-top"><div><a href="/" class="footer-brand">vylo.</a><p>Household accounts, spending,<br />budgets, and net worth.</p></div><div class="footer-directory"><nav aria-label="Explore Vylo"><span>VYLO</span><a href="#the-story">The founder’s letter</a><a href="#inside-vylo">Features</a><a href="#pricing">Pricing</a><a href="/updates/">What’s new</a></nav><nav aria-label="Support and policies"><span>HELP & POLICIES</span><a href="mailto:hi@myvylo.com">Contact</a><a href="#security">Security</a><a href="https://app.myvylo.com/privacy-policy">Privacy policy</a><a href="https://app.myvylo.com/terms-of-use">Terms of use</a></nav></div></div>
      <div class="footer-bottom"><span>© 2026 Vylo</span></div>
    </footer>
    <script>
      import '../scripts/founder-demos';
    </script>
    <noscript><style>.product-tabs, .walkthrough-chapters { display: none; } .walkthrough-track { display: block; } .walkthrough-slide { margin-top: 40px; } .product-explorer { grid-template-columns: 1fr; } .product-panels [hidden] { display: block !important; margin-top: 40px; }</style></noscript>
  </body>
</html>
