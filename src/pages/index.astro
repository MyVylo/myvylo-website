<!-- ════════════════════════════════════════════════════════════════
     CTA BANNER
════════════════════════════════════════════════════════════════ -->
<section class="py-16 px-4 sm:px-6">
  <div class="reveal max-w-3xl mx-auto text-center glass rounded-2xl card-glow px-8 py-14"
       style="background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(241,245,249,.92));">
    <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Ready for a <span class="title-accent">clearer month?</span></h2>
    <p class="text-white/75 text-lg mb-8 max-w-md mx-auto">Connect your accounts in minutes. Vylo keeps the household view current from there.</p>
    <a href="https://app.myvylo.com/signup"
       class="button-shimmer inline-flex items-center gap-2 px-7 py-3.5
              text-white font-semibold rounded-xl text-sm transition-all duration-200
              hover:shadow-xl hover:shadow-indigo-500/30 hover:-translate-y-0.5"
       style="background: linear-gradient(135deg, var(--cta-start), var(--cta-end));">
      Get started
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<script>
  // Hero indicator dots
  const dots = document.querySelectorAll('.dot');
  function updateDots() {
    const phase = Math.floor((Date.now() / 1000) % 9 / 3);
    dots.forEach((d, i) => {
      d.classList.toggle('bg-indigo-400', i === phase);
      d.classList.toggle('bg-white/20',   i !== phase);
    });
  }
  setInterval(updateDots, 120);
  updateDots();

  // Scroll-reveal
  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObserver.unobserve(e.target); }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // Bar / height animations
  const barObserver = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (!e.isIntersecting) return;
      // Horizontal bars (width)
      e.target.querySelectorAll('[data-w]').forEach((bar) => {
        const el = bar as HTMLElement;
        el.style.width = el.dataset.w!;
      });
      // Vertical bars (height)
      e.target.querySelectorAll('[data-h]').forEach((bar) => {
        const el = bar as HTMLElement;
        el.style.height = el.dataset.h!;
      });
      barObserver.unobserve(e.target);
    }),
    { threshold: 0.25 }
  );
  document.querySelectorAll('.bar-section').forEach(el => barObserver.observe(el));

  // Feature story scene sync
  const featureSteps = Array.from(document.querySelectorAll<HTMLElement>('.feature-step'));
  const featureBeats = Array.from(document.querySelectorAll<HTMLElement>('.feature-beat'));
  const featureScenes = Array.from(document.querySelectorAll<HTMLElement>('.feature-scene'));
  const featureCaption = document.querySelector<HTMLElement>('#feature-caption');
  const featureDemoWrap = document.querySelector<HTMLElement>('.feature-demo-wrap');
  const captions = [
    'New transactions are organized as they arrive.',
    'Budget status updates as spending changes.',
    'Household members share one current view of spending.',
    'Assets and debt roll into one net-worth snapshot.',
  ];
  const featureDemoAnchor = document.createComment('feature-demo-anchor');

  if (featureDemoWrap?.parentNode) {
    featureDemoWrap.parentNode.insertBefore(featureDemoAnchor, featureDemoWrap);
  }

  function useInlineMobileFeatureDemo() {
    return window.innerWidth < 1024;
  }

  function syncFeatureDemoPlacement(index: number) {
    if (!featureDemoWrap || !featureDemoAnchor) return;

    if (useInlineMobileFeatureDemo()) {
      featureDemoWrap.classList.add('feature-demo-inline');
      featureSteps[index]?.appendChild(featureDemoWrap);
      return;
    }

    featureDemoWrap.classList.remove('feature-demo-inline');
    featureDemoAnchor.parentNode?.insertBefore(featureDemoWrap, featureDemoAnchor.nextSibling);
  }

  function setFeatureScene(index: number) {
    syncFeatureDemoPlacement(index);
    featureBeats.forEach((beat, i) => beat.classList.toggle('is-active', i === index));
    featureScenes.forEach((scene, i) => scene.classList.toggle('is-active', i === index));
    if (featureCaption) featureCaption.textContent = captions[index] ?? captions[0];
  }

  let featureScrollTicking = false;

  function featureTriggerY() {
    const nav = document.querySelector<HTMLElement>('#nav');
    const navHeight = nav?.getBoundingClientRect().height ?? 0;

    if (useInlineMobileFeatureDemo()) {
      return navHeight + Math.min(176, Math.max(96, window.innerHeight * 0.18));
    }

    return navHeight + Math.min(140, Math.max(96, window.innerHeight * 0.16));
  }

  function syncFeatureSceneToScroll() {
    const triggers = featureSteps.length ? featureSteps : featureBeats;
    if (!triggers.length) return;

    const triggerY = featureTriggerY();
    let activeIndex = 0;

    triggers.forEach((trigger, index) => {
      if (trigger.getBoundingClientRect().top <= triggerY) {
        activeIndex = index;
      }
    });

    setFeatureScene(activeIndex);
  }

  function requestFeatureSceneSync() {
    if (featureScrollTicking) return;
    featureScrollTicking = true;
    requestAnimationFrame(() => {
      syncFeatureSceneToScroll();
      featureScrollTicking = false;
    });
  }

  window.addEventListener('scroll', requestFeatureSceneSync, { passive: true });
  window.addEventListener('resize', requestFeatureSceneSync);
  syncFeatureSceneToScroll();

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon   = btn.querySelector('.faq-icon')!;
      const isOpen = answer.classList.toggle('open');
      icon.classList.toggle('open', isOpen);
      btn.closest('#faq-list')!.querySelectorAll('.faq-answer').forEach(a => {
        if (a !== answer) {
          a.classList.remove('open');
          (a.previousElementSibling as HTMLElement).querySelector('.faq-icon')!.classList.remove('open');
        }
      });
    });
  });
</script>

</Layout>
