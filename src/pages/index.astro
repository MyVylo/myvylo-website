---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vylo – Household finances, organized automatically."
  description="Connect your accounts once. Vylo organizes transactions, budgets, net worth, and household spending into one clear shared view."
>

<!-- ════════════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════════ -->
<section class="hero-glow relative overflow-hidden pt-32 pb-20 px-4 sm:px-6">
  <div class="bg-grid absolute inset-0 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Copy -->
      <div class="flex-1 text-center lg:text-left max-w-xl mx-auto lg:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full
                    bg-indigo-500/10 border border-indigo-500/20
                    text-indigo-300 text-xs font-medium mb-6 fade-in-up">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
          Finance, without the noise.
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold leading-[1.1] tracking-tight gradient-text mb-5 fade-in-up delay-100">
          Simple finance tracking for the common <span class="title-accent">household.</span>
        </h1>

        <p class="text-white/75 text-lg leading-relaxed mb-8 fade-in-up delay-200">
          Connect your accounts and let Vylo do the rest—categorized transactions, updated budgets, and one household view, without the dreaded Sunday spreadsheet session you always skip.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start fade-in-up delay-300">
          <a href="https://app.myvylo.com/signup"
             class="button-shimmer px-6 py-3 text-white text-sm font-semibold
                    rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/30 hover:-translate-y-0.5"
             style="background: linear-gradient(135deg, var(--cta-start), var(--cta-end));">
            Get started
          </a>
          <a href="#features"
             class="px-6 py-3 border border-white/10 hover:border-white/25 text-white/75
                    hover:text-white text-sm font-medium rounded-xl transition-all duration-200">
            See how Vylo works
          </a>
        </div>

        <p class="mt-5 text-xs text-white/30 fade-in-up delay-400">
          First month $2 · Read-only bank connections
        </p>
      </div>

      <!-- App mockup -->
      <div class="flex-1 w-full max-w-[420px] lg:max-w-none mx-auto lg:mx-0">
        <div class="relative" style="max-width:420px; margin:0 auto;">
          <div class="absolute -inset-6 rounded-3xl bg-indigo-500/10 blur-3xl pointer-events-none"></div>
          <div class="hero-float-card hero-float-card-a">
            <span>Transaction sorted</span>
            <strong>Whole Foods · Groceries</strong>
          </div>
          <div class="hero-float-card hero-float-card-b">
            <span>Budget status</span>
            <strong>Projected $180 under</strong>
          </div>

          <div class="relative app-surface glass rounded-2xl card-glow overflow-hidden">
            <div class="relative p-4" style="min-height:340px;">

              <!-- Screen 1: Dashboard -->
              <div class="screen-1 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-1">Household overview · April</p>
                <p class="text-2xl font-bold font-mono text-white mb-4">$612<span class="text-sm text-white/35 font-sans font-normal"> left to spend</span></p>
                <div class="flex items-end gap-1.5 h-20 mb-4">
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:42%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:60%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:38%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/35" style="height:75%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:52%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/45" style="height:88%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500"    style="height:68%"></div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-indigo-400"></div><span class="text-[11px] text-white/70">Groceries</span></div>
                    <span class="text-[11px] font-mono text-white">$842</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-emerald-400"></div><span class="text-[11px] text-white/70">Dining out</span></div>
                    <span class="text-[11px] font-mono text-white">$614</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-amber-400"></div><span class="text-[11px] text-white/70">Transport</span></div>
                    <span class="text-[11px] font-mono text-white">$390</span>
                  </div>
                </div>
              </div>

              <!-- Screen 2: Auto-categorization -->
              <div class="screen-2 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Transactions reviewed</p>
                <div class="space-y-2">
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-emerald-500/20 text-emerald-400 text-[11px] font-bold flex items-center justify-center">W</div>
                      <div><p class="text-[11px] text-white font-medium">Whole Foods</p><p class="text-[10px] text-white/40">→ Groceries</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$67.43</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-amber-500/20 text-amber-400 text-[11px] font-bold flex items-center justify-center">U</div>
                      <div><p class="text-[11px] text-white font-medium">Uber</p><p class="text-[10px] text-white/40">→ Transport</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$14.20</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-indigo-500/10 border border-indigo-500/25">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-indigo-500/20 text-indigo-400 text-[11px] font-bold flex items-center justify-center">N</div>
                      <div><p class="text-[11px] text-white font-medium">Netflix</p><p class="text-[10px] text-indigo-400">→ Subscriptions</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$15.99</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-rose-500/20 text-rose-400 text-[11px] font-bold flex items-center justify-center">S</div>
                      <div><p class="text-[11px] text-white font-medium">Sweetgreen</p><p class="text-[10px] text-white/40">→ Dining out</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$18.75</span>
                  </div>
                </div>
              </div>

              <!-- Screen 3: Budget insights -->
              <div class="screen-3 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Budget progress · March</p>
                <div class="space-y-3.5">
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Groceries</span><span class="text-[11px] font-mono text-white">$842 <span class="text-white/35">/ $1,000</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-emerald-400 rounded-full" style="width:84%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Dining out</span><span class="text-[11px] font-mono text-amber-400">$614 <span class="text-white/35">/ $600</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-amber-400 rounded-full" style="width:100%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Transport</span><span class="text-[11px] font-mono text-white">$390 <span class="text-white/35">/ $500</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:78%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Subscriptions</span><span class="text-[11px] font-mono text-white">$127 <span class="text-white/35">/ $200</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:64%"></div></div>
                  </div>
                  <div class="pt-1.5 border-t border-white/[0.06] flex justify-between">
                    <span class="text-[10px] text-white/35">3 on track</span>
                    <span class="text-[10px] text-amber-400">1 over budget</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- indicator dots -->
          <div class="hero-demo-footer">
            <div class="flex justify-center gap-2">
              <div class="dot w-1.5 h-1.5 rounded-full bg-indigo-400" data-index="0"></div>
              <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="1"></div>
              <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="2"></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     NOT EVERYONE'S A FINANCE BRO
════════════════════════════════════════════════════════════════ -->
<section id="clarity" class="clarity-section scroll-mt-28 py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="clarity-heading reveal">
      <p class="text-indigo-400 text-xs uppercase tracking-widest font-semibold mb-3">One household view</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold gradient-text mb-4">From scattered tools to a <span class="title-accent">shared financial picture.</span></h2>
      <p class="text-white/75 text-lg max-w-2xl">
        Household finances usually live across bank apps, cards, receipts, and conversations. Vylo brings the important pieces together: what was spent, what is left, what is projected, and which categories need attention.
      </p>
    </div>

    <div class="clarity-cinema reveal reveal-d1" aria-label="Animated comparison of messy finances becoming a clear Vylo dashboard">
      <div class="mess-side" aria-hidden="true">
        <div class="mess-label">Chaos before Vylo</div>
        <div class="mess-grid"></div>
        <div class="mess-tangle">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="mess-item mess-sheet">
          <div class="mess-sheet-top">budget-final-v7.xlsx</div>
          <div class="mess-cells">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="mess-item mess-sheet mess-sheet-alt">
          <div class="mess-sheet-top">actual-budget-copy.xlsx</div>
          <div class="mess-cells">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
        <div class="mess-item mess-receipt">
          <span>Receipt</span>
          <strong>$84.21</strong>
          <i></i><i></i><i></i>
        </div>
        <div class="mess-item mess-receipt mess-receipt-alt">
          <span>Subscription</span>
          <strong>$17.99?</strong>
          <i></i><i></i><i></i>
        </div>
        <div class="mess-item mess-bank">
          <span>Bank app 3 of 4</span>
          <strong>Pending...</strong>
        </div>
        <div class="mess-item mess-bank mess-bank-alt">
          <span>Card balance</span>
          <strong>$1,268?</strong>
        </div>
        <div class="mess-item mess-text">
          <span>Did we pay this?</span>
        </div>
        <div class="mess-item mess-text mess-text-alt">
          <span>Split this later</span>
        </div>
        <div class="mess-item mess-alert">
          <span>Budget status</span>
          <strong>Unclear</strong>
        </div>
        <div class="mess-item mess-calendar">
          <span>Sunday</span>
          <strong>catch up?</strong>
        </div>
        <div class="mess-item mess-note">
          <span>Groceries or household?</span>
        </div>
        <div class="mess-noise mess-noise-a">duplicate?</div>
        <div class="mess-noise mess-noise-b">uncategorized</div>
        <div class="mess-noise mess-noise-c">who paid?</div>
        <div class="mess-noise mess-noise-d">old file</div>
        <div class="mess-noise mess-noise-e">pending</div>
      </div>

      <div class="clarity-beam" aria-hidden="true">
        <span></span>
      </div>

      <div class="clear-side" aria-hidden="true">
        <div class="sunwash"></div>
        <div class="sun-ray sun-ray-a"></div>
        <div class="sun-ray sun-ray-b"></div>
        <div class="mess-label clear-label">Clarity with Vylo</div>
        <div class="clarity-dashboard">
          <div class="clarity-dashboard-body">
            <div class="budget-hero-row">
              <div class="budget-balance">
                <p class="clarity-eyebrow">Budget health</p>
                <strong>$612</strong>
                <span>left to spend</span>
                <small>$3,388 spent of $4,000 budgeted</small>
              </div>
              <div class="budget-halo" style="--p: 85%">
                <span>85%</span>
                <small>used</small>
              </div>
            </div>

            <div class="budget-forecast-strip">
              <div>
                <span>Projected</span>
                <strong>$3,820</strong>
                <small>$180 under plan</small>
              </div>
              <div>
                <span>Daily pace</span>
                <strong>$67</strong>
                <small>safe for April</small>
              </div>
              <div>
                <span>Watchlist</span>
                <strong>2</strong>
                <small>watch closely</small>
              </div>
            </div>

            <div class="budget-watchlist">
              <div class="budget-watch-heading">
                <span>Top categories to watch</span>
                <strong><i></i> Updated now</strong>
              </div>
              <div class="budget-watch-row watch-amber">
                <div>
                  <span>Dining out</span>
                  <small>Projected $715 / $760</small>
                  <i style="--w: 94%"></i>
                </div>
                <strong>$45 left</strong>
              </div>
              <div class="budget-watch-row watch-emerald">
                <div>
                  <span>Groceries</span>
                  <small>Projected $872 / $1,000</small>
                  <i style="--w: 87%"></i>
                </div>
                <strong>$128 left</strong>
              </div>
              <div class="budget-watch-row watch-indigo">
                <div>
                  <span>Transport</span>
                  <small>Projected $332 / $500</small>
                  <i style="--w: 66%"></i>
                </div>
                <strong>$168 left</strong>
              </div>
            </div>
          </div>
        </div>
        <div class="clarity-pill clarity-pill-a">$612 left to spend</div>
        <div class="clarity-pill clarity-pill-b">Projected under plan</div>
        <div class="clarity-pill clarity-pill-c">2 categories to watch</div>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════════════════
     FEATURES
════════════════════════════════════════════════════════════════ -->
<section id="features" class="scroll-mt-24 pt-16 pb-6 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal">
      <p class="text-indigo-400 text-xs uppercase tracking-widest font-semibold mb-3">Features</p>
      <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Everything you need. None of the <span class="title-accent">finance-bro fluff.</span></h2>
      <p class="text-white/75 text-lg max-w-2xl mx-auto">Most finance apps have become expensive, overly complex, and oddly intense. Vylo keeps things simple: automatic tracking, clear budgets, and one shared household view built for real life — not spreadsheet hobbyists.</p>
    </div>

    <div class="feature-story grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8 lg:gap-12 items-start">
      <div class="feature-steps">
        {[
          {
            eyebrow: '01 · Auto-categorization',
            title: 'Transactions categorize themselves.',
            copy: 'Merchant details are mapped to the right categories automatically, with easy corrections when your household wants to fine-tune the rules.',
            accent: 'indigo',
          },
          {
            eyebrow: '02 · Budget status',
            title: 'See where the month is headed.',
            copy: 'Vylo shows what is left to spend, what you are projected to spend by month-end, and which categories are starting to drift before they turn into a problem.',
            accent: 'amber',
          },
          {
            eyebrow: '03 · Household view',
            title: 'Keep everyone aligned.',
            copy: 'Partners, housemates, or family members can each connect their own accounts and see one current household picture.',
            accent: 'emerald',
          },
          {
            eyebrow: '04 · Net worth',
            title: 'See assets and debt together.',
            copy: 'Cash, investments, property, debt, and other assets roll into one clear net-worth snapshot.',
            accent: 'violet',
          },
        ].map((feature, index) => (
          <div class="feature-step" data-feature={index}>
            <article class={`feature-beat reveal ${index === 0 ? 'is-active' : ''}`}>
              <p class={`feature-kicker feature-kicker-${feature.accent}`}>{feature.eyebrow}</p>
              <h3>{feature.title}</h3>
              <p>{feature.copy}</p>
            </article>
          </div>
        ))}
      </div>

      <div class="feature-demo-wrap">
        <div class="feature-demo app-surface glass card-glow">
          <div class="feature-scenes">
            <div class="feature-scene is-active" data-scene="0">
              <div class="transaction-stack">
                {[
                  ['T', "Trader Joe's", 'Groceries', '$84.21', 'emerald'],
                  ['S', 'Spotify', 'Subscriptions', '$11.99', 'indigo'],
                  ['C', 'Chipotle', 'Dining out', '$18.44', 'rose'],
                  ['U', 'Uber', 'Transport', '$24.10', 'amber'],
                ].map(([letter, merchant, category, amount, accent]) => (
                  <div class={`demo-transaction demo-transaction-${accent}`}>
                    <div class="merchant-mark">{letter}</div>
                    <div>
                      <p>{merchant}</p>
                      <span>{category}</span>
                    </div>
                    <strong>{amount}</strong>
                  </div>
                ))}
              </div>
            </div>

            <div class="feature-scene" data-scene="1">
              <div class="budget-radar">
                <div class="budget-ring">
                  <span>82%</span>
                  <small>month used</small>
                </div>
                <div class="budget-lines">
                  <div><span>Groceries</span><strong>$842 / $1,000</strong></div>
                  <div><span>Dining out</span><strong class="text-amber-300">$614 / $600</strong></div>
                  <div><span>Transport</span><strong>$390 / $500</strong></div>
                </div>
              </div>
            </div>

            <div class="feature-scene" data-scene="2">
              <div class="household-orbit">
                <div class="household-person person-a">A</div>
                <div class="household-person person-b">J</div>
                <div class="household-person person-c">K</div>
                <div class="household-center">
                  <span>$3,241</span>
                  <small>shared spend</small>
                </div>
              </div>
            </div>

            <div class="feature-scene" data-scene="3">
              <div class="worth-board">
                <div class="worth-total">
                  <span>Household net worth</span>
                  <strong>$284,500</strong>
                </div>
                <div class="worth-bars">
                  <div style="--w: 37%"><span>Cash</span><i></i><strong>$45k</strong></div>
                  <div style="--w: 78%"><span>Investments</span><i></i><strong>$120k</strong></div>
                  <div style="--w: 100%"><span>Property</span><i></i><strong>$160k</strong></div>
                  <div style="--w: 13%"><span>Debt</span><i></i><strong>-$40.5k</strong></div>
                </div>
              </div>
            </div>
          </div>

          <div class="demo-caption">
            <span class="caption-dot"></span>
            <p id="feature-caption">New transactions are organized as they arrive.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     SECURITY
════════════════════════════════════════════════════════════════ -->
<section id="security" class="scroll-mt-24 pt-8 pb-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="glass rounded-2xl card-glow p-8 sm:p-12 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-indigo-400 text-xs uppercase tracking-widest font-semibold mb-3">Security</p>
        <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Bank-grade security <span class="title-accent">you can trust.</span></h2>
        <p class="text-white/75 leading-relaxed mb-6">Vylo connects through Plaid, the same infrastructure used by Venmo and Robinhood. Vylo receives read-only transaction data. Your banking credentials never touch our servers.</p>
        <a href="https://app.myvylo.com/signup"
           class="button-shimmer inline-flex items-center gap-2 px-5 py-2.5
                  text-white text-sm font-semibold rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-indigo-500/25"
           style="background: linear-gradient(135deg, var(--cta-start), var(--cta-end));">
          Get started securely
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-white/[0.04] border border-white/[0.06]">
          <div class="w-9 h-9 rounded-lg bg-indigo-500/20 flex items-center justify-center mb-3"><svg width="17" height="17" viewBox="0 0 16 16" fill="none"><path d="M8 1L2 4v4c0 3.5 2.5 5.8 6 7 3.5-1.2 6-3.5 6-7V4L8 1z" stroke="#818cf8" stroke-width="1.3" stroke-linejoin="round"/></svg></div>
          <h4 class="text-sm font-semibold text-white mb-1">Powered by Plaid</h4>
          <p class="text-xs text-white/70 leading-relaxed">The same trusted infrastructure used by Venmo, Robinhood, and thousands of financial apps.</p>
        </div>
