---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vylo – Simple finance tracking for the common household."
  description="Connect your bank once. Every transaction shows up, automatically categorized and tracked. No spreadsheets. No dashboards. Just clarity."
>

<!-- ════════════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════════ -->
<section class="hero-glow relative overflow-hidden pt-32 pb-20 px-4 sm:px-6">
  <div class="bg-grid absolute inset-0 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Copy -->
      <div class="flex-1 text-center lg:text-left max-w-xl mx-auto lg:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full
                    bg-indigo-500/10 border border-indigo-500/20
                    text-indigo-300 text-xs font-medium mb-6 fade-in-up">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          Finance, without the noise.
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold leading-[1.1] tracking-tight gradient-text mb-5 fade-in-up delay-100">
          Simple finance tracking for the common household.
        </h1>

        <p class="text-white/75 text-lg leading-relaxed mb-8 fade-in-up delay-200">
          Your full financial picture in less than 2 minutes. No spreadsheets. No manual tracking. No Sunday-night catch-up. Vylo is simple finance tracking for the everyday household, without the inflated price tag.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start fade-in-up delay-300">
          <a href="https://app.myvylo.com/signup"
             class="button-shimmer px-6 py-3 text-white text-sm font-semibold
                    rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/30 hover:-translate-y-0.5"
             style="background: linear-gradient(135deg, #6366f1, #7c3aed);">
            Get started — it's free
          </a>
          <a href="#features"
             class="px-6 py-3 border border-white/10 hover:border-white/25 text-white/75
                    hover:text-white text-sm font-medium rounded-xl transition-all duration-200">
            See how it works
          </a>
        </div>

        <p class="mt-5 text-xs text-white/30 fade-in-up delay-400">
          7-day free trial · Bank-level encryption · No credit card required
        </p>
      </div>

      <!-- App mockup -->
      <div class="flex-1 w-full max-w-[420px] lg:max-w-none mx-auto lg:mx-0">
        <div class="relative" style="max-width:420px; margin:0 auto;">
          <div class="absolute -inset-6 rounded-3xl bg-indigo-500/10 blur-3xl pointer-events-none"></div>

          <div class="relative glass rounded-2xl card-glow overflow-hidden">
            <!-- Window chrome -->
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/[0.06]">
              <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
              <div class="ml-3 flex-1 bg-white/[0.05] rounded h-5 flex items-center px-2.5">
                <span class="text-[10px] text-white/25 font-mono">app.myvylo.com</span>
              </div>
            </div>

            <div class="relative p-4" style="min-height:340px;">

              <!-- Screen 1: Dashboard -->
              <div class="screen-1 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-1">Total spend · March</p>
                <p class="text-2xl font-bold font-mono text-white mb-4">$3,241<span class="text-sm text-white/35 font-sans font-normal">.58</span></p>
                <div class="flex items-end gap-1.5 h-20 mb-4">
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:42%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:60%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:38%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/35" style="height:75%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:52%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/45" style="height:88%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500"    style="height:68%"></div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-indigo-400"></div><span class="text-[11px] text-white/70">Groceries</span></div>
                    <span class="text-[11px] font-mono text-white">$842</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-emerald-400"></div><span class="text-[11px] text-white/70">Dining out</span></div>
                    <span class="text-[11px] font-mono text-white">$614</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-amber-400"></div><span class="text-[11px] text-white/70">Transport</span></div>
                    <span class="text-[11px] font-mono text-white">$390</span>
                  </div>
                </div>
              </div>

              <!-- Screen 2: Auto-categorization -->
              <div class="screen-2 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Auto-categorizing</p>
                <div class="space-y-2">
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-emerald-500/20 text-emerald-400 text-[11px] font-bold flex items-center justify-center">W</div>
                      <div><p class="text-[11px] text-white font-medium">Whole Foods</p><p class="text-[10px] text-white/40">→ Groceries</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$67.43</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-amber-500/20 text-amber-400 text-[11px] font-bold flex items-center justify-center">U</div>
                      <div><p class="text-[11px] text-white font-medium">Uber</p><p class="text-[10px] text-white/40">→ Transport</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$14.20</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-indigo-500/10 border border-indigo-500/25">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-indigo-500/20 text-indigo-400 text-[11px] font-bold flex items-center justify-center">N</div>
                      <div><p class="text-[11px] text-white font-medium">Netflix</p><p class="text-[10px] text-indigo-400">→ Subscriptions ✓</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$15.99</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-rose-500/20 text-rose-400 text-[11px] font-bold flex items-center justify-center">S</div>
                      <div><p class="text-[11px] text-white font-medium">Sweetgreen</p><p class="text-[10px] text-white/40">→ Dining out</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$18.75</span>
                  </div>
                </div>
              </div>

              <!-- Screen 3: Budget insights -->
              <div class="screen-3 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Budget progress · March</p>
                <div class="space-y-3.5">
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Groceries</span><span class="text-[11px] font-mono text-white">$842 <span class="text-white/35">/ $1,000</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-emerald-400 rounded-full" style="width:84%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Dining out</span><span class="text-[11px] font-mono text-amber-400">$614 <span class="text-white/35">/ $600</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-amber-400 rounded-full" style="width:100%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Transport</span><span class="text-[11px] font-mono text-white">$390 <span class="text-white/35">/ $500</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:78%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Subscriptions</span><span class="text-[11px] font-mono text-white">$127 <span class="text-white/35">/ $200</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:64%"></div></div>
                  </div>
                  <div class="pt-1.5 border-t border-white/[0.06] flex justify-between">
                    <span class="text-[10px] text-white/35">3 on track</span>
                    <span class="text-[10px] text-amber-400">1 over budget</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- indicator dots -->
          <div class="flex justify-center gap-2 mt-4">
            <div class="dot w-1.5 h-1.5 rounded-full bg-indigo-400" data-index="0"></div>
            <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="1"></div>
            <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="2"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     NOT EVERYONE'S A FINANCE BRO — Emotional World Slider
════════════════════════════════════════════════════════════════ -->
<section class="py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Not everyone's a finance bro.</h2>
      <p class="text-white/75 text-lg max-w-xl mx-auto">
        You shouldn't need a spreadsheet, a "money guy," or a second job just to stay on top of your finances.
      </p>
    </div>

    <div class="reveal reveal-d1 max-w-4xl mx-auto">

      <!-- Slider container -->
      <div
        id="vylo-slider"
        tabindex="0"
        role="img"
        aria-label="Interactive scene comparison. Drag to reveal the emotional difference between managing finances before Vylo and with Vylo."
        class="vylo-scene relative rounded-2xl overflow-hidden select-none cursor-ew-resize"
      >

        <!-- ══════════════════════════════════════════════════════
             BEFORE WORLD — stressed, late-night, overwhelmed
             Base layer: always fully visible beneath the after panel
        ══════════════════════════════════════════════════════ -->
        <div class="absolute inset-0 overflow-hidden" style="background:#06090f;">

          <!-- Cold atmospheric gradient: harsh blue-white overhead light, no warmth -->
          <div class="absolute inset-0 pointer-events-none" style="background:
            radial-gradient(ellipse 55% 45% at 50% 0%,   rgba(60,100,200,0.14), transparent 60%),
            radial-gradient(ellipse 80% 35% at 50% 100%, rgba(2,4,10,0.95),     transparent);"></div>

          <!-- Wall (upper ~63% of scene) -->
          <div style="position:absolute; top:0; left:0; right:0; height:63%; background:linear-gradient(180deg, #0b1120 0%, #080e1c 100%);"></div>

          <!-- Window: same position as after-side — behind person, rainy & gloomy -->
          <div style="position:absolute; top:5%; left:50%; transform:translateX(-50%); width:min(185px,46%); aspect-ratio:185/235; border-radius:5px 5px 2px 2px; overflow:hidden; border:1px solid rgba(255,255,255,0.07);">
            <!-- Dark rainy interior -->
            <div style="position:absolute; inset:0; background:linear-gradient(180deg, #03070e 0%, #020609 100%);"></div>
            <!-- Cold blue ambient from outside -->
            <div style="position:absolute; inset:0; background:radial-gradient(ellipse 80% 55% at 50% 20%, rgba(50,90,200,0.14), transparent 65%);"></div>
            <!-- Rain streaks (CSS animated) -->
            <div class="rain-bg" style="position:absolute; inset:-30px; opacity:1;"></div>
            <!-- Frame cross-bars -->
            <div style="position:absolute; top:0; bottom:0; left:50%; width:1px; background:rgba(255,255,255,0.06);"></div>
            <div style="position:absolute; left:0; right:0; top:48%; height:1px; background:rgba(255,255,255,0.06);"></div>
          </div>

          <!-- Window sill -->
          <div style="position:absolute; top:calc(5% + min(235px,59.5%)); left:50%; transform:translateX(-50%); width:min(205px,51%); height:7px; background:#0c1828; border-radius:2px;"></div>

          <!-- Desk surface: cold dark plane, y≈63% -->
          <div style="position:absolute; top:63%; left:0; right:0; bottom:0; background:#050810;"></div>
          <!-- Desk edge/surface line -->
          <div style="position:absolute; top:63%; left:0; right:0; height:5px; background:#0e1a2a;"></div>

          <!-- Scattered papers (on desk, left of center) -->
          <div style="position:absolute; top:58%; left:4%;  width:min(110px,27%); height:min(70px,17%); background:#0f1726; border:1px solid rgba(255,255,255,0.07); border-radius:2px; transform:rotate(-11deg);"></div>
          <div style="position:absolute; top:56%; left:8%;  width:min(90px,22%);  height:min(60px,15%); background:#0d1423; border:1px solid rgba(255,255,255,0.05); border-radius:2px; transform:rotate(7deg);"></div>
          <div style="position:absolute; top:60%; left:2%;  width:min(75px,18%);  height:min(50px,12%); background:#0b1220; border:1px solid rgba(255,255,255,0.04); border-radius:2px; transform:rotate(-4deg);"></div>
          <!-- Crumpled ball -->
          <div style="position:absolute; top:59.5%; left:24%; width:min(18px,4%); height:min(18px,4%); background:#10192a; border:1px solid rgba(255,255,255,0.05); border-radius:50%;"></div>

          <!-- Coffee mug (right of center, desk level) -->
          <div style="position:absolute; top:59%; left:60%; width:min(26px,6%); height:min(32px,8%); border:2px solid rgba(255,255,255,0.12); border-radius:2px 2px 4px 4px; background:#080e1a;">
            <div style="position:absolute; right:-9px; top:5px; width:9px; height:min(17px,4%); border:2px solid rgba(255,255,255,0.12); border-left:none; border-radius:0 6px 6px 0;"></div>
          </div>

          <!-- Dim desk lamp (left side, casting limited cold pool) -->
          <div style="position:absolute; top:48%; left:15%; width:6px; height:min(60px,15%); background:#0e1828; border-radius:3px;"></div>
          <div style="position:absolute; top:46%; left:12%; width:min(22px,5.5%); height:min(14px,3.5%); background:#0e1828; border-radius:8px 8px 2px 2px;"></div>

          <!-- Person: sitting at desk, hunched and exhausted
               Right arm raised toward forehead (facepalm / frustration).
               Left arm resting forward on desk. Slight forward lean. -->
          <div style="position:absolute; bottom:35%; left:50%; transform:translateX(-50%); width:min(130px,34%);">
            <svg viewBox="0 0 130 240" style="width:100%; height:auto; display:block;" fill="none">
              <!-- Head: tilted forward/down via rotation — exhaustion posture -->
              <ellipse cx="68" cy="34" rx="23" ry="26" fill="#13202e" transform="rotate(10 68 50)"/>
              <!-- Neck -->
              <rect x="61" y="57" width="13" height="11" rx="4" fill="#101c2e"/>
              <!-- Body/torso: hunched — slightly forward lean -->
              <path d="M17 76 C15 68 28 64 45 66 L60 66 L60 62 L70 62 L70 66 L85 66 C102 64 115 68 113 76 C116 95 113 130 109 162 L21 162 C17 130 14 95 17 76 Z" fill="#101c2e"/>
              <!-- Right arm: RAISED toward head — the facepalm of financial fatigue -->
              <path d="M109 85 C120 74 126 60 120 46" stroke="#101c2e" stroke-width="19" fill="none" stroke-linecap="round"/>
              <ellipse cx="118" cy="42" rx="12" ry="9" fill="#101c2e" transform="rotate(-22 118 42)"/>
              <!-- Left arm: forward and down, leaning on desk -->
              <path d="M21 85 C9 106 5 132 6 162" stroke="#101c2e" stroke-width="19" fill="none" stroke-linecap="round"/>
            </svg>
          </div>

          <!-- Thought fragments: the internal monologue of financial avoidance -->
          <!-- Primary — large, the one that resonates most -->
          <p style="position:absolute; bottom:27%; left:4%; font-size:clamp(11px,1.5vw,14px); font-style:italic; color:rgba(255,255,255,0.38); transform:rotate(-2deg);">"I'll do it tomorrow."</p>
          <!-- Secondary thoughts, progressively fainter -->
          <p style="position:absolute; top:42%; left:3%;  font-size:clamp(9px,1.2vw,11px); font-style:italic; color:rgba(255,255,255,0.24); transform:rotate(-1deg);">"I'm too tired for this."</p>
          <p style="position:absolute; top:20%; left:5%;  font-size:clamp(8px,1.1vw,10px); font-style:italic; color:rgba(255,255,255,0.18);">"Did I already pay that?"</p>
          <p style="position:absolute; bottom:14%; left:3%; font-size:clamp(7px,1vw,9px);   font-style:italic; color:rgba(255,255,255,0.14); transform:rotate(-0.5deg);">"I'll catch up on Sunday."</p>
          <!-- Right side — visible through the initial clip -->
          <p style="position:absolute; top:28%; right:36%; font-size:clamp(8px,1.1vw,10px); font-style:italic; color:rgba(255,255,255,0.16);">"Where did it all go?"</p>

        </div><!-- /before world -->


        <!-- ══════════════════════════════════════════════════════
             AFTER WORLD — calm, clear, handled, lighter
             Clipped panel: revealed as user drags left
        ══════════════════════════════════════════════════════ -->
        <div
          id="slider-after"
          class="absolute inset-0 overflow-hidden"
          style="background:#0d1828; clip-path:inset(0 0 0 62%);"
        >
          <!-- Warm natural-light atmosphere: sunlight from the window, breathing room -->
          <div class="absolute inset-0 pointer-events-none" style="background:
            radial-gradient(ellipse 60% 55% at 50% 2%,  rgba(255,200,100,0.10), transparent 60%),
            radial-gradient(ellipse 45% 40% at 72% 55%, rgba(52,211,153,0.04),  transparent 60%),
            radial-gradient(ellipse 80% 35% at 50% 100%, rgba(5,10,22,0.92),    transparent);"></div>

          <!-- Wall (same proportion — now warm-tinted) -->
          <div style="position:absolute; top:0; left:0; right:0; height:63%; background:linear-gradient(180deg, #111d30 0%, #0e1828 100%);"></div>

          <!-- Soft sunlight shaft from window, falling diagonally across wall -->
          <div class="absolute pointer-events-none" style="top:0; left:calc(50% - 15%); width:30%; height:65%; background:linear-gradient(175deg, rgba(255,210,120,0.06) 0%, transparent 70%); transform-origin:top center; transform:rotate(3deg);"></div>

          <!-- Window: same exact position — now warm, clear, daylight -->
          <div style="position:absolute; top:5%; left:50%; transform:translateX(-50%); width:min(185px,46%); aspect-ratio:185/235; border-radius:5px 5px 2px 2px; overflow:hidden; border:1px solid rgba(255,215,120,0.12);">
            <!-- Warm clear sky interior -->
            <div style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(255,210,130,0.10) 0%, rgba(160,210,255,0.07) 55%, rgba(90,160,255,0.06) 100%);"></div>
            <!-- Warm ambient glow (morning sun) -->
            <div style="position:absolute; inset:0; background:radial-gradient(ellipse 85% 55% at 50% 15%, rgba(255,220,140,0.16), transparent 70%);"></div>
            <!-- Frame cross-bars (warm tint) -->
            <div style="position:absolute; top:0; bottom:0; left:50%; width:1px; background:rgba(255,210,100,0.10);"></div>
            <div style="position:absolute; left:0; right:0; top:48%; height:1px; background:rgba(255,210,100,0.10);"></div>
          </div>

          <!-- Window sill (same position, slightly warmer) -->
          <div style="position:absolute; top:calc(5% + min(235px,59.5%)); left:50%; transform:translateX(-50%); width:min(205px,51%); height:7px; background:#172535; border-radius:2px;"></div>

          <!-- Desk surface: same plane, now clean -->
          <div style="position:absolute; top:63%; left:0; right:0; bottom:0; background:#0a1422;"></div>
          <!-- Desk edge -->
          <div style="position:absolute; top:63%; left:0; right:0; height:5px; background:#142234;"></div>

          <!-- Small potted plant — single calm life detail on desk right side -->
          <div style="position:absolute; top:54%; left:62%;">
            <svg viewBox="0 0 52 98" style="width:min(52px,13%); height:auto; display:block;" fill="none">
              <!-- Pot -->
              <path d="M11 86 C10 78 9 70 17 67 L35 67 C43 70 42 78 41 86 Z" fill="#182e24"/>
              <rect x="8" y="65" width="36" height="6" rx="3" fill="#1c3629"/>
              <!-- Stem -->
              <path d="M26 65 C26 56 25 44 25 32" stroke="#1c3629" stroke-width="2.5" stroke-linecap="round"/>
              <!-- Leaf 1 -->
              <path d="M25 46 C20 40 13 31 16 21 C18 15 25 17 25 31" fill="#1c3629" opacity="0.95"/>
              <!-- Leaf 2 -->
              <path d="M25 42 C31 36 38 27 35 17 C33 11 25 14 25 28" fill="#1c3629" opacity="0.85"/>
              <!-- Leaf 3 (small, top) -->
              <path d="M25 33 C23 28 19 22 21 15 C23 10 27 12 25 26" fill="#1c3629" opacity="0.70"/>
            </svg>
          </div>

          <!-- Clean coffee mug (same position, no chaos around it) -->
          <div style="position:absolute; top:59%; left:60%; width:min(24px,6%); height:min(30px,7.5%); border:1.5px solid rgba(255,255,255,0.09); border-radius:2px 2px 4px 4px; background:#0c1828;">
            <div style="position:absolute; right:-8px; top:5px; width:8px; height:min(15px,4%); border:1.5px solid rgba(255,255,255,0.09); border-left:none; border-radius:0 5px 5px 0;"></div>
          </div>

          <!-- Person: sitting at desk, upright and calm
               Both arms resting at sides — open, relaxed posture.
               Head level. Shoulders down. -->
          <div style="position:absolute; bottom:35%; left:50%; transform:translateX(-50%); width:min(130px,34%);">
            <svg viewBox="0 0 130 240" style="width:100%; height:auto; display:block;" fill="none">
              <!-- Head: level, upright — ease and presence -->
              <circle cx="65" cy="30" r="23" fill="#1c2d44"/>
              <!-- Neck -->
              <rect x="58" y="50" width="14" height="11" rx="4" fill="#192640"/>
              <!-- Body: upright, open, relaxed -->
              <path d="M15 70 C13 62 27 58 45 60 L58 60 L58 56 L72 56 L72 60 L85 60 C103 58 117 62 115 70 C119 89 117 124 113 156 L17 156 C13 124 11 89 15 70 Z" fill="#192640"/>
              <!-- Both arms resting down — the exhale of someone not bracing -->
              <path d="M19 78 C8 100 5 126 6 156" stroke="#192640" stroke-width="19" fill="none" stroke-linecap="round"/>
