              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="faq-answer px-5 pb-4">
            <p class="text-sm text-white/70 leading-relaxed">{a}</p>
          </div>
        </div>
      ))}

    </div>
  </div>
</section>


