---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vylo – Simple finance tracking for the common household."
  description="Connect your bank once. Every transaction shows up, automatically categorized and tracked. No spreadsheets. No dashboards. Just clarity."
>

<!-- ════════════════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════════════ -->
<section class="hero-glow relative overflow-hidden pt-32 pb-20 px-4 sm:px-6">
  <div class="bg-grid absolute inset-0 pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">

      <!-- Copy -->
      <div class="flex-1 text-center lg:text-left max-w-xl mx-auto lg:mx-0">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full
                    bg-indigo-500/10 border border-indigo-500/20
                    text-indigo-300 text-xs font-medium mb-6 fade-in-up">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
          Finance, without the noise.
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-bold leading-[1.1] tracking-tight gradient-text mb-5 fade-in-up delay-100">
          Simple finance tracking for the common household.
        </h1>

        <p class="text-white/75 text-lg leading-relaxed mb-8 fade-in-up delay-200">
          Your full financial picture in less than 2 minutes. No spreadsheets. No manual tracking. No Sunday-night catch-up. Vylo is simple finance tracking for the everyday household, without the inflated price tag.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start fade-in-up delay-300">
          <a href="https://app.myvylo.com/signup"
             class="button-shimmer px-6 py-3 text-white text-sm font-semibold
                    rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/30 hover:-translate-y-0.5"
             style="background: linear-gradient(135deg, #6366f1, #7c3aed);">
            Get started — it's free
          </a>
          <a href="#features"
             class="px-6 py-3 border border-white/10 hover:border-white/25 text-white/75
                    hover:text-white text-sm font-medium rounded-xl transition-all duration-200">
            See how it works
          </a>
        </div>

        <p class="mt-5 text-xs text-white/30 fade-in-up delay-400">
          7-day free trial · Bank-level encryption · No credit card required
        </p>
      </div>

      <!-- App mockup -->
      <div class="flex-1 w-full max-w-[420px] lg:max-w-none mx-auto lg:mx-0">
        <div class="relative" style="max-width:420px; margin:0 auto;">
          <div class="absolute -inset-6 rounded-3xl bg-indigo-500/10 blur-3xl pointer-events-none"></div>

          <div class="relative glass rounded-2xl card-glow overflow-hidden">
            <!-- Window chrome -->
            <div class="flex items-center gap-1.5 px-4 py-3 border-b border-white/[0.06]">
              <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
              <div class="ml-3 flex-1 bg-white/[0.05] rounded h-5 flex items-center px-2.5">
                <span class="text-[10px] text-white/25 font-mono">app.myvylo.com</span>
              </div>
            </div>

            <div class="relative p-4" style="min-height:340px;">

              <!-- Screen 1: Dashboard -->
              <div class="screen-1 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-1">Total spend · March</p>
                <p class="text-2xl font-bold font-mono text-white mb-4">$3,241<span class="text-sm text-white/35 font-sans font-normal">.58</span></p>
                <div class="flex items-end gap-1.5 h-20 mb-4">
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:42%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:60%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/25" style="height:38%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/35" style="height:75%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/30" style="height:52%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500/45" style="height:88%"></div>
                  <div class="flex-1 rounded-t-sm bg-indigo-500"    style="height:68%"></div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-indigo-400"></div><span class="text-[11px] text-white/70">Groceries</span></div>
                    <span class="text-[11px] font-mono text-white">$842</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-emerald-400"></div><span class="text-[11px] text-white/70">Dining out</span></div>
                    <span class="text-[11px] font-mono text-white">$614</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-amber-400"></div><span class="text-[11px] text-white/70">Transport</span></div>
                    <span class="text-[11px] font-mono text-white">$390</span>
                  </div>
                </div>
              </div>

              <!-- Screen 2: Auto-categorization -->
              <div class="screen-2 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Auto-categorizing</p>
                <div class="space-y-2">
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-emerald-500/20 text-emerald-400 text-[11px] font-bold flex items-center justify-center">W</div>
                      <div><p class="text-[11px] text-white font-medium">Whole Foods</p><p class="text-[10px] text-white/40">→ Groceries</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$67.43</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-amber-500/20 text-amber-400 text-[11px] font-bold flex items-center justify-center">U</div>
                      <div><p class="text-[11px] text-white font-medium">Uber</p><p class="text-[10px] text-white/40">→ Transport</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$14.20</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-indigo-500/10 border border-indigo-500/25">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-indigo-500/20 text-indigo-400 text-[11px] font-bold flex items-center justify-center">N</div>
                      <div><p class="text-[11px] text-white font-medium">Netflix</p><p class="text-[10px] text-indigo-400">→ Subscriptions ✓</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$15.99</span>
                  </div>
                  <div class="flex items-center justify-between p-2.5 rounded-lg bg-white/[0.04] border border-white/[0.06]">
                    <div class="flex items-center gap-2.5">
                      <div class="w-7 h-7 rounded-md bg-rose-500/20 text-rose-400 text-[11px] font-bold flex items-center justify-center">S</div>
                      <div><p class="text-[11px] text-white font-medium">Sweetgreen</p><p class="text-[10px] text-white/40">→ Dining out</p></div>
                    </div>
                    <span class="text-[11px] font-mono text-white">$18.75</span>
                  </div>
                </div>
              </div>

              <!-- Screen 3: Budget insights -->
              <div class="screen-3 absolute inset-4">
                <p class="text-[10px] uppercase tracking-widest text-white/35 font-semibold mb-3">Budget progress · March</p>
                <div class="space-y-3.5">
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Groceries</span><span class="text-[11px] font-mono text-white">$842 <span class="text-white/35">/ $1,000</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-emerald-400 rounded-full" style="width:84%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Dining out</span><span class="text-[11px] font-mono text-amber-400">$614 <span class="text-white/35">/ $600</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-amber-400 rounded-full" style="width:100%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Transport</span><span class="text-[11px] font-mono text-white">$390 <span class="text-white/35">/ $500</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:78%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1.5"><span class="text-[11px] text-white/75">Subscriptions</span><span class="text-[11px] font-mono text-white">$127 <span class="text-white/35">/ $200</span></span></div>
                    <div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-full bg-indigo-400 rounded-full" style="width:64%"></div></div>
                  </div>
                  <div class="pt-1.5 border-t border-white/[0.06] flex justify-between">
                    <span class="text-[10px] text-white/35">3 on track</span>
                    <span class="text-[10px] text-amber-400">1 over budget</span>
                  </div>
                </div>
              </div>

            </div>
          </div>

          <!-- indicator dots -->
          <div class="flex justify-center gap-2 mt-4">
            <div class="dot w-1.5 h-1.5 rounded-full bg-indigo-400" data-index="0"></div>
            <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="1"></div>
            <div class="dot w-1.5 h-1.5 rounded-full bg-white/20"   data-index="2"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ════════════════════════════════════════════════════════════════
     NOT EVERYONE'S A FINANCE BRO — Before/After Slider
════════════════════════════════════════════════════════════════ -->
<section class="py-20 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold gradient-text mb-4">Not everyone's a finance bro.</h2>
      <p class="text-white/75 text-lg max-w-xl mx-auto">
        You shouldn't need a spreadsheet, a "money guy," or a second job just to stay on top of your finances.
      </p>
    </div>

    <div class="reveal reveal-d1 max-w-4xl mx-auto">

      <!-- Slider container -->
      <div
        id="vylo-slider"
        tabindex="0"
        role="img"
        aria-label="Interactive before/after comparison. Drag or use arrow keys to reveal managing finances before Vylo versus with Vylo."
        class="relative rounded-2xl overflow-hidden select-none cursor-ew-resize"
        style="height:420px;"
      >

        <!-- ── BEFORE scene (base layer, always visible) ──────── -->
        <div class="absolute inset-0 overflow-hidden" style="background:#161c2c;">

          <!-- Warm ambient glow: frustration, late-night tension -->
          <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 60% 70% at 18% 70%, rgba(251,146,60,0.08), transparent 65%), radial-gradient(ellipse 45% 45% at 40% 20%, rgba(239,68,68,0.04), transparent 65%);"></div>

          <!-- Time indicator -->
          <p style="position:absolute; top:18px; left:18px; font-size:10px; font-family:monospace; letter-spacing:0.05em; color:rgba(255,255,255,0.22);">11:47 PM · Sun</p>

          <!-- Banking app badges: the cognitive overhead of 4 apps -->
          <div style="position:absolute; top:13px; left:90px; display:flex; flex-wrap:wrap; gap:5px; max-width:200px;">
            <span style="font-size:9px; padding:3px 8px; border-radius:5px; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.09); color:rgba(255,255,255,0.42);">Chase</span>
            <span style="font-size:9px; padding:3px 8px; border-radius:5px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07); color:rgba(255,255,255,0.32);">Amex</span>
            <span style="font-size:9px; padding:3px 8px; border-radius:5px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); color:rgba(255,255,255,0.24);">Venmo</span>
            <span style="font-size:9px; padding:3px 8px; border-radius:5px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); color:rgba(255,255,255,0.18);">PayPal</span>
          </div>

          <!-- Messy spreadsheet fragment -->
          <div style="position:absolute; top:66px; left:18px; width:min(230px, 44%);">
            <div style="border-radius:8px; border:1px solid rgba(255,255,255,0.08); overflow:hidden; background:rgba(12,16,26,0.65);">
              <div style="display:grid; grid-template-columns:58px 1fr 52px; border-bottom:1px solid rgba(255,255,255,0.05); font-size:8px;">
                <div style="padding:4px 7px; color:rgba(255,255,255,0.22); border-right:1px solid rgba(255,255,255,0.05);">Date</div>
                <div style="padding:4px 7px; color:rgba(255,255,255,0.22); border-right:1px solid rgba(255,255,255,0.05);">Description</div>
                <div style="padding:4px 7px; color:rgba(255,255,255,0.22); text-align:right;">Amt</div>
              </div>
              <div style="display:grid; grid-template-columns:58px 1fr 52px; border-bottom:1px solid rgba(255,255,255,0.04); font-size:8px;">
                <div style="padding:4px 7px; color:rgba(255,255,255,0.38); border-right:1px solid rgba(255,255,255,0.04);">Mar 2</div>
                <div style="padding:4px 7px; color:rgba(255,255,255,0.48); border-right:1px solid rgba(255,255,255,0.04);">Grocery?</div>
                <div style="padding:4px 7px; color:rgba(245,158,11,0.60); text-align:right;">???</div>
              </div>
              <div style="display:grid; grid-template-columns:58px 1fr 52px; border-bottom:1px solid rgba(255,255,255,0.04); font-size:8px;">
                <div style="padding:4px 7px; color:rgba(255,255,255,0.28); border-right:1px solid rgba(255,255,255,0.04);">Feb 27</div>
                <div style="padding:4px 7px; color:rgba(255,255,255,0.40); border-right:1px solid rgba(255,255,255,0.04);">Amazon (x3?)</div>
                <div style="padding:4px 7px; color:rgba(245,158,11,0.65); text-align:right;">-$847</div>
              </div>
              <div style="display:grid; grid-template-columns:58px 1fr 52px; border-bottom:1px solid rgba(255,255,255,0.03); font-size:8px;">
                <div style="padding:4px 7px; color:rgba(255,255,255,0.14); border-right:1px solid rgba(255,255,255,0.03);">???</div>
                <div style="padding:4px 7px; color:rgba(255,255,255,0.14); border-right:1px solid rgba(255,255,255,0.03);">need to fill in</div>
                <div style="padding:4px 7px;"></div>
              </div>
              <div style="display:grid; grid-template-columns:58px 1fr 52px; font-size:8px;">
                <div style="padding:4px 7px; border-right:1px solid rgba(255,255,255,0.02);"></div>
                <div style="padding:4px 7px; border-right:1px solid rgba(255,255,255,0.02);"></div>
                <div style="padding:4px 7px;"></div>
              </div>
            </div>
          </div>

          <!-- Thought fragments: the emotional truth of financial avoidance -->
          <p style="position:absolute; bottom:96px; left:18px; font-size:14px; font-style:italic; color:rgba(255,255,255,0.36); transform:rotate(-1.5deg);">"I'll do it tomorrow."</p>
          <p style="position:absolute; bottom:62px; left:24px; font-size:11px; font-style:italic; color:rgba(255,255,255,0.22); transform:rotate(-0.5deg);">"Where did it all go?"</p>
          <p style="position:absolute; top:270px; left:18px; font-size:10px; font-style:italic; color:rgba(255,255,255,0.18);">"Did I already pay that?"</p>
          <p style="position:absolute; bottom:18px; left:18px; font-size:9px; font-style:italic; color:rgba(255,255,255,0.12);">"I'll catch up on Sunday."</p>

        </div><!-- /before -->


        <!-- ── WITH VYLO scene (clipped — drag left to reveal) ── -->
        <div
          id="slider-after"
          class="absolute inset-0 overflow-hidden"
          style="background:#1a2437; clip-path:inset(0 0 0 60%);"
        >
          <!-- Cool indigo glow: calm, organized, clear -->
          <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 65% 60% at 78% 45%, rgba(99,102,241,0.13), transparent 65%), radial-gradient(ellipse 40% 40% at 68% 80%, rgba(52,211,153,0.06), transparent 65%);"></div>

          <!-- Vylo card: clean, centered in the right zone -->
          <div style="position:absolute; top:50%; left:68%; transform:translate(-50%,-50%); width:220px;">
            <div style="background:rgba(32,43,65,0.93); border:1px solid rgba(99,102,241,0.20); border-radius:16px; padding:18px; box-shadow:0 0 0 1px rgba(99,102,241,0.08), 0 8px 40px rgba(0,0,0,0.55);">

              <!-- All accounts summary -->
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
                <div>
                  <p style="font-size:9px; color:rgba(255,255,255,0.42); text-transform:uppercase; letter-spacing:0.07em; margin:0 0 3px;">All accounts</p>
                  <p style="font-size:20px; font-weight:700; color:white; line-height:1.1; margin:0;">$12,847<span style="font-size:12px; font-weight:400; color:rgba(255,255,255,0.38);">.32</span></p>
                </div>
                <div style="display:flex; align-items:center; gap:5px;">
                  <div style="width:6px; height:6px; border-radius:50%; background:#34d399; flex-shrink:0;"></div>
                  <span style="font-size:9px; color:#34d399; font-weight:500;">Synced</span>
                </div>
              </div>

              <!-- Transaction rows (auto-categorized) -->
              <div style="display:flex; flex-direction:column; gap:9px; margin-bottom:14px;">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                  <div>
                    <p style="font-size:11px; color:white; font-weight:500; margin:0; line-height:1.25;">Whole Foods</p>
                    <p style="font-size:9px; color:rgba(52,211,153,0.80); margin:0; line-height:1.3;">→ Groceries</p>
                  </div>
                  <span style="font-size:10px; font-family:monospace; color:rgba(255,255,255,0.78);">−$94.12</span>
                </div>
                <div style="display:flex; align-items:center; justify-content:space-between;">
                  <div>
                    <p style="font-size:11px; color:white; font-weight:500; margin:0; line-height:1.25;">Netflix</p>
                    <p style="font-size:9px; color:rgba(129,140,248,0.80); margin:0; line-height:1.3;">→ Entertainment</p>
                  </div>
                  <span style="font-size:10px; font-family:monospace; color:rgba(255,255,255,0.78);">−$15.99</span>
                </div>
                <div style="display:flex; align-items:center; justify-content:space-between;">
                  <div>
                    <p style="font-size:11px; color:white; font-weight:500; margin:0; line-height:1.25;">Direct Deposit</p>
                    <p style="font-size:9px; color:rgba(56,189,248,0.80); margin:0; line-height:1.3;">→ Income</p>
                  </div>
                  <span style="font-size:10px; font-family:monospace; color:#34d399;">+$3,200</span>
                </div>
              </div>

              <!-- Budget bar -->
              <div style="padding-top:12px; border-top:1px solid rgba(255,255,255,0.07);">
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                  <span style="font-size:9px; color:rgba(255,255,255,0.48);">Groceries</span>
                  <span style="font-size:9px; font-family:monospace; color:rgba(255,255,255,0.68);">$642 / $1,000</span>
                </div>
                <div style="height:5px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden;">
                  <div style="height:100%; width:64%; background:#34d399; border-radius:4px;"></div>
                </div>
              </div>

            </div>
          </div><!-- /vylo card -->

          <!-- Thought fragments: the exhale -->
          <p style="position:absolute; top:24px; right:22px; font-size:13px; font-style:italic; color:rgba(165,180,252,0.52); transform:rotate(0.5deg);">"Finally."</p>
          <p style="position:absolute; bottom:26px; right:26px; font-size:10px; font-style:italic; color:rgba(52,211,153,0.45);">"Still on budget."</p>

        </div><!-- /after -->


        <!-- ── Labels (always on top of both scenes) ─────────── -->
        <div style="position:absolute; top:14px; left:14px; z-index:20; pointer-events:none;">
          <span style="font-size:10px; padding:3px 10px; border-radius:20px; background:rgba(0,0,0,0.42); border:1px solid rgba(255,255,255,0.10); color:rgba(255,255,255,0.55); font-weight:600; letter-spacing:0.05em; text-transform:uppercase;">Before</span>
        </div>
        <div style="position:absolute; top:14px; right:14px; z-index:20; pointer-events:none;">
          <span style="font-size:10px; padding:3px 10px; border-radius:20px; background:rgba(99,102,241,0.18); border:1px solid rgba(99,102,241,0.30); color:rgba(165,180,252,0.90); font-weight:600; letter-spacing:0.05em; text-transform:uppercase;">With Vylo</span>
        </div>


        <!-- ── Drag handle ─────────────────────────────────────── -->
        <div
          id="slider-handle"
          style="position:absolute; top:0; bottom:0; left:60%; transform:translateX(-50%); display:flex; align-items:center; z-index:30; pointer-events:none;"
        >
          <!-- Vertical glow line -->
          <div style="position:absolute; top:0; bottom:0; left:50%; transform:translateX(-50%); width:1px; background:rgba(255,255,255,0.30); box-shadow:0 0 12px rgba(255,255,255,0.15);"></div>
          <!-- Grip circle -->
          <div class="slider-grip" style="position:relative; width:42px; height:42px; border-radius:50%; background:white; display:flex; align-items:center; justify-content:center; flex-shrink:0; z-index:1;">
            <svg width="17" height="17" viewBox="0 0 17 17" fill="none">
              <path d="M6 8.5l-3-2.5 3-2.5" stroke="#1a2437" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
