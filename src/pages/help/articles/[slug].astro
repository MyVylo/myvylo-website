---
import { getCollection } from 'astro:content';
import PlatformGuides from '../../../components/help/PlatformGuides.astro';
import guides from '../../../data/help-guides.json';
import HelpLayout from '../../../layouts/HelpLayout.astro';
import { helpCategories, articleUrl } from '../../../lib/help';
export async function getStaticPaths(){return (await getCollection('help')).map(article=>({params:{slug:article.slug},props:{article}}));}
const {article} = Astro.props;
const articles = (await getCollection('help')).sort((a,b)=>a.data.order-b.data.order);
const category = helpCategories.find(c=>c.id===article.data.category)!;
const {Content, headings} = await article.render();
const guide = (guides as Record<string,any>)[article.slug];
const outline = [...headings.filter(h=>h.depth===2), ...(guide ? [{slug:'on-the-web',text:'On the web'},{slug:'on-iphone',text:'On iPhone'}] : [])];
const related = article.data.related.map((slug:string)=>articles.find(a=>a.slug===slug)).filter(Boolean);
---
<HelpLayout title={article.data.title} description={article.data.description}>
<main class="page-width help-article-layout" id="main"><aside class="article-sidebar"><details open id="article-browser"><summary>Browse help articles</summary><a class="all-help" href="/help/">All help topics</a><form class="sidebar-search" action="/help/" role="search"><label class="sr-only" for="article-query">Search help articles</label><input id="article-query" type="search" name="q" placeholder="Search help…" /><button type="submit">Search</button></form><nav aria-label="Help articles">{helpCategories.map(c=><details class="article-category" open={c.id===category.id}><summary>{c.title}</summary><ul>{articles.filter(a=>a.data.category===c.id).map(a=><li><a href={articleUrl(a.slug)} aria-current={a.slug===article.slug?'page':undefined}>{a.data.title}</a>{a.slug===article.slug&&<ul class="article-outline">{outline.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>}</li>)}</ul></details>)}</nav></details><p class="sidebar-contact">Still stuck?<br/><a href="mailto:hi@myvylo.com">hi@myvylo.com</a></p></aside>
<article class="help-article"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/help/">Help</a><span aria-hidden="true">/</span><a href={`/help/?topic=${category.id}`}>{category.title}</a></nav><h1>{article.data.title}</h1><p class="article-lede">{article.data.description}</p><div class="article-content">{guide&&<nav class="platform-jumps" aria-label="Choose your device"><a href="#on-the-web">On the web</a><a href="#on-iphone">On iPhone</a></nav>}<Content /><PlatformGuides guide={guide}/></div>{article.data.screenshot&&<figure class="app-figure"><a href={`/help/${article.data.screenshot}`} target="_blank" rel="noopener" aria-label="Open app screenshot at full size"><img src={`/help/${article.data.screenshot}`} alt={article.data.screenshotAlt||article.data.title} width="1320" height="2868" loading="lazy" /></a><figcaption>{article.data.screenshotAlt}<span>Vylo for iPhone · Tap the image to enlarge</span></figcaption></figure>}<aside class="article-contact"><h2>Need a hand with this?</h2><p>Email <a href={`mailto:hi@myvylo.com?subject=${encodeURIComponent('Help with: '+article.data.title)}`}>hi@myvylo.com</a>. Tell us where you got stuck and we’ll help you through it.</p></aside>{related.length>0&&<section class="related-articles"><h2>Related articles</h2><ul>{related.map((a:any)=><li><a href={articleUrl(a.slug)}>{a.data.title}</a></li>)}</ul></section>}</article></main>
<script>
if(matchMedia('(max-width: 760px)').matches)document.querySelector<HTMLDetailsElement>('#article-browser')!.open=false;
document.querySelectorAll<HTMLTableElement>('.article-content table').forEach(table=>{
  table.tabIndex=0;
  const hint=document.createElement('p');
  hint.className='table-scroll-hint';
  hint.textContent='Swipe across the table to see all columns.';
  table.before(hint);
});
</script>
</HelpLayout>
