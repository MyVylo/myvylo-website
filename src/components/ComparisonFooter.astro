---
import { marketCopy } from '../edge/screenshot-market.js';
const countryCopy = marketCopy('US');
---
<footer class="site-end page-width">
  <div class="footer-top">
    <div><a href="/" class="footer-brand" aria-label="Vylo home"><img src="/vylo-light-logo.svg" alt="Vylo" width="282" height="129" loading="lazy" /></a><p>Household accounts, spending,<br />budgets, and net worth.</p></div>
    <div class="footer-directory">
      <nav aria-label="Explore Vylo"><span>VYLO</span><a href="/#the-story">Why we built Vylo</a><a href="/#inside-vylo">Features</a><a href="/#pricing">Pricing</a><a href="/compare/">Compare</a><a href="/updates/">What’s new</a></nav>
      <nav aria-label="Support and policies"><span>HELP & POLICIES</span><a href="/help/">Help center</a><a href="mailto:hi@myvylo.com">Contact</a><a href="/#security">Security</a><a href="https://app.myvylo.com/privacy-policy">Privacy policy</a><a href="https://app.myvylo.com/terms-of-use">Terms of use</a></nav>
    </div>
  </div>
  <div class="footer-bottom"><span>© 2026 Vylo</span><div class="screenshot-market-choice"><span data-screenshot-market-description aria-live="polite">{countryCopy.viewing}</span><a data-screenshot-market-switch href={`?market=${countryCopy.next}`}>{countryCopy.switchLabel}</a></div></div>
</footer>
