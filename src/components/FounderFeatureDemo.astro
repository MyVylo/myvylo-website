---
import '../styles/app-screen-demos.css';
import captures from '../data/app-screen-captures.json';
interface Props { scene: keyof typeof captures; }
const {scene} = Astro.props;
const frames = captures[scene];
const captions = frames.map(frame=>frame.caption);
const path = '/product/current-20260914/us/';
---
<div class="feature-demo-player app-screen-player" data-demo={scene} data-captions={JSON.stringify(captions)}>
  <div class="demo-surface" role="img" aria-label={captions[0]}>
    <div class="app-screen-viewport" aria-hidden="true">
      {frames.map((frame,index)=>{
        return <div class="app-screen-frame" data-screen-frame={index} data-image={`${path}${frame.file}`} data-visible={String(index===0)}>
          <img data-market-image={frame.file} src={`${path}${frame.file}`} alt="" width={frame.width} height={frame.height} loading="lazy" decoding="async" />
        </div>;
      })}
    </div>
    <div class="demo-timeline" aria-hidden="true"><span></span></div>
  </div>
  <div class="demo-controls" hidden>
    <p data-demo-caption>{captions[0]}</p>
    <div><button type="button" data-demo-toggle>Pause</button><button type="button" data-demo-replay>Replay</button><a data-market-image-link={frames[0].file} data-demo-image-link href={`${path}${frames[0].file}`} target="_blank" rel="noopener" aria-label="Enlarge app screenshot">Enlarge</a></div>
  </div>
</div>
