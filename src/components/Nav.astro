---
const { currentPage = '' } = Astro.props;
---

<nav id="nav" class="fixed top-0 inset-x-0 z-50 px-4 sm:px-6 pt-4">
  <div class="max-w-6xl mx-auto">
    <div class="nav-shell">

      <div class="flex items-center justify-between h-16 px-4 sm:px-5">

      <!-- Logo -->
      <a href="/" class="brand-logo flex items-center flex-shrink-0" aria-label="Vylo home">
        <img src="/vylo-light-logo.svg" alt="Vylo" width="282" height="129" />
      </a>

      <!-- Centre links -->
      <div class="nav-links hidden md:flex items-center">
        <a href="/#features" class="nav-link" data-nav-target="features">Product</a>
        <a href="/#security" class="nav-link" data-nav-target="security">Security</a>
        <a href="/#pricing"  class="nav-link" data-nav-target="pricing">Pricing</a>
        <a href="/updates"
           class:list={['nav-link', { 'is-active': currentPage === 'updates' }]}>
          Updates
        </a>
      </div>

      <!-- Right CTAs -->
      <div class="nav-actions hidden md:flex items-center gap-2">
        <a href="https://app.myvylo.com/signin"
           class="nav-signin">
          Sign in
        </a>
        <a href="https://app.myvylo.com/signup"
           class="nav-cta">
          Get started
        </a>
      </div>

      <!-- Hamburger -->
      <button id="menu-btn" class="nav-menu-btn md:hidden" aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
        <svg id="icon-open"  width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        <svg id="icon-close" class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
      </button>
      </div>
    </div>

    <!-- Mobile drawer -->
    <div id="mobile-menu">
      <div class="mobile-menu-panel flex flex-col gap-1">
        <a href="/#features" onclick="closeMobileMenu()" class="mobile-nav-link">Product</a>
        <a href="/#security" onclick="closeMobileMenu()" class="mobile-nav-link">Security</a>
        <a href="/#pricing"  onclick="closeMobileMenu()" class="mobile-nav-link">Pricing</a>
        <a href="/updates"   onclick="closeMobileMenu()" class="mobile-nav-link">Updates</a>
        <div class="pt-2 flex flex-col gap-2">
          <a href="https://app.myvylo.com/signin"
             class="nav-signin-mobile">
            Sign in
          </a>
          <a href="https://app.myvylo.com/signup"
             class="nav-cta-mobile">
            Get started
          </a>
        </div>
      </div>
    </div>

  </div>
</nav>

<script>
  const nav      = document.getElementById('nav')!;
  const menuBtn  = document.getElementById('menu-btn')!;
  const mobileMenu = document.getElementById('mobile-menu')!;
  const iconOpen  = document.getElementById('icon-open')!;
  const iconClose = document.getElementById('icon-close')!;
  const navLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-target]'));
  const sectionLinks = navLinks
    .map(link => ({
      link,
      section: document.getElementById(link.dataset.navTarget ?? ''),
    }))
    .filter(({ section }) => Boolean(section))
    .sort((a, b) => a.section!.offsetTop - b.section!.offsetTop) as { link: HTMLElement; section: HTMLElement }[];

  function updateNavState() {
    nav.classList.toggle('scrolled', window.scrollY > 24);

    if (window.location.pathname !== '/' || !sectionLinks.length) return;

    let active: { link: HTMLElement; section: HTMLElement } | null = null;

    sectionLinks.forEach(item => {
      if (item.section.getBoundingClientRect().top <= 120) active = item;
    });

    navLinks.forEach(link => link.classList.toggle('is-active', link === active?.link));
  }

  window.addEventListener('scroll', updateNavState, { passive: true });
  window.addEventListener('resize', updateNavState);
  updateNavState();

  menuBtn.addEventListener('click', () => {
    const open = mobileMenu.classList.toggle('open');
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    menuBtn.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('click', e => {
    if (!menuBtn.contains(e.target as Node) && !mobileMenu.contains(e.target as Node)) {
      closeMobileMenu();
    }
  });

  function closeMobileMenu() {
    mobileMenu.classList.remove('open');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
    menuBtn.setAttribute('aria-expanded', 'false');
  }

  (window as any).closeMobileMenu = closeMobileMenu;
</script>
