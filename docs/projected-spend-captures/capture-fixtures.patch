+ // Shell composition copied from MainTabView.signedInShell / signedInStack.
+ @MainActor private func websiteShell<V:View>(tab:Int,@ViewBuilder content:@escaping ()->V) -> some View {
+  ZStack(alignment:.bottom) {
+   VyloBackdrop()
+   TabView(selection:Binding.constant(tab)) {
+    ForEach(0..<4) { index in
+     Group {
+      if index == tab {
+       NavigationStack {
+        ZStack { VyloBackdrop(); content().frame(maxWidth:.infinity,maxHeight:.infinity,alignment:.topLeading) }
+        .navigationBarTitleDisplayMode(.inline)
+        .toolbar { ToolbarItem(placement:.topBarTrailing) { VyloToolbarIconButton(systemName:"slider.horizontal.3",accessibilityLabel:"Open settings",iconSize:9.1,controlSize:30.8,action:{}) } }
+       }.toolbarBackground(.hidden,for:.navigationBar)
+      } else { Color.clear }
+     }.tabItem { Label(["Home","Activity","Budget","Net Worth"][index],systemImage:["house.fill","list.bullet.rectangle","chart.bar.fill","wallet.pass.fill"][index]) }.tag(index)
+    }
+   }.tint(VyloColor.text).toolbarBackground(.visible,for:.tabBar).toolbarColorScheme(.dark,for:.tabBar)
+   ShellPrimaryActionButton {}.padding(.bottom,24)
+  }
+ }
+ @MainActor private func websiteRender<V: View>(_ view:V,name:String,locale:Locale,height:CGFloat = 896) async throws {
+  let hosted = UIHostingController(rootView:view.environment(\.colorScheme,.dark).environment(\.locale,locale).environment(\.valueVisibility,.init(hidesSensitiveValues:false)).background(VyloColor.background))
+  hosted.overrideUserInterfaceStyle = .dark
+  let window = UIWindow(frame:CGRect(x:0,y:0,width:414,height:height)); window.overrideUserInterfaceStyle = .dark
+  window.rootViewController = hosted; window.makeKeyAndVisible()
+  hosted.view.frame = window.bounds
+  hosted.view.setNeedsLayout(); hosted.view.layoutIfNeeded()
+  try await Task.sleep(for:.milliseconds(450))
+  hosted.view.layoutIfNeeded()
+  let format = UIGraphicsImageRendererFormat();format.scale=3
+  let image = UIGraphicsImageRenderer(size:window.bounds.size,format:format).image { _ in hosted.view.drawHierarchy(in:window.bounds,afterScreenUpdates:true) }
+  let attachment = XCTAttachment(image:image);attachment.name=name;attachment.lifetime = .keepAlways;add(attachment)
+  window.isHidden=true;window.rootViewController=nil
+ }
 }
